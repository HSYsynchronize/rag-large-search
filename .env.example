# 复制本文件为 .env，填入你自己的配置。
# .env 已在 .gitignore 中，不会被提交到仓库。

# OpenAI 兼容的 API key（必填）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# API 网关地址（默认官方地址；若用第三方网关/本地服务，改成对应地址）
OPENAI_API_BASE=https://api.openai.com/v1

# 模型（默认官方模型；若用自建网关，改成网关支持的模型名）
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 向量维度：必须和 EMBEDDING_MODEL 的输出维度一致
# text-embedding-3-small → 1536，bge-m3 → 1024
VECTOR_DIM=1536

# 生成的数据量（对话条数）
DATA_SIZE=10000